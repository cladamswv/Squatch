{
  "name": "squatch-crossing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "playcanvas": "2.22.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
